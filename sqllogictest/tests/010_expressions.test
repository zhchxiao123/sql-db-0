----
2

query I
SELECT 5 - 2
----
3

query I
SELECT 3 * 4
----
12

query I
SELECT 7 / 2
----
3

query R
SELECT 7.0 / 2
----
3.500

query I
SELECT 7 % 3
----
1

query I
SELECT -5 + 10
----
5

query I
SELECT 1 < 2
----
1

query I
SELECT 2 <= 1
----
0

query I
SELECT 3 = 3
----
1

query I
SELECT 3 != 4
----
1

query I
SELECT 1 AND 1
----
1

query I
SELECT 1 AND 0
----
0

query I
