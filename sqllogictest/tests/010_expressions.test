----
1

query I
SELECT abs(-3)
----
3

query T
SELECT lower('HELLO')
----
hello

query T
SELECT upper('world')
----
WORLD

query I
SELECT length('hello')
----
5

query I
SELECT coalesce(NULL, 42)
----
42

query T
SELECT 'a' || 'b' || 'c'
----
abc

query T
SELECT substr('hello', 2, 3)
----
ell

query T
SELECT trim('  hi  ')
----
hi

query I
SELECT CASE WHEN 1 > 0 THEN 10 ELSE 20 END
----
10

query I
SELECT CASE WHEN 0 > 0 THEN 10 ELSE 20 END
----
20

query I
SELECT 5 BETWEEN 1 AND 10
----
1

query I
SELECT 5 IN (1, 3, 5)
----
1

query I
SELECT 5 IN (1, 3)
----
0

query I
SELECT 'hello' LIKE '%ell%'
----
1

query I
SELECT 'hello' LIKE 'h_llo'
----
1

query I
SELECT 'hello' LIKE 'xyz'
----
